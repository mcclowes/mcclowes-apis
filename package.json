{
  "name": "mcclowes-api",
  "version": "2.0.0",
  "description": "Todoist API - Vercel Serverless Functions",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "format": "prettier --write \"api/**/*.js\" \"_lib/**/*.js\"",
    "format:staged": "pretty-quick --staged --pattern \"./api/**\" \"./lib/**\"",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run format:staged"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcclowes/what-the-fpl-api.git"
  },
  "engines": {
    "node": "22.x"
  },
  "author": "mcclowes",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mcclowes/what-the-fpl-api/issues"
  },
  "homepage": "https://github.com/mcclowes/what-the-fpl-api#readme",
  "dependencies": {
    "@doist/todoist-api-typescript": "^3.0.0",
    "node-fetch": "^2.7.0",
    "openai": "^4.28.0"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "pretty-quick": "^4.0.0",
    "vercel": "latest"
  }
}
